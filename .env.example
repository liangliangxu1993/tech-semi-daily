# ===== 推送渠道 =====
# 选择推送渠道：serverchan / wecom / both
PUSH_CHANNEL=serverchan

# Server酱 Turbo 的 SendKey（https://sct.ftqq.com 登录后获取）
SERVERCHAN_SENDKEY=

# 企业微信群机器人 Webhook（群设置 -> 添加机器人 -> 复制 Webhook 地址）
WECOM_WEBHOOK=

# ===== LLM 分析 =====
# Anthropic Claude API Key（https://console.anthropic.com）
ANTHROPIC_API_KEY=
# 模型：claude-haiku-4-5(低成本默认) / claude-sonnet-5(更高质量)
LLM_MODEL=claude-haiku-4-5
# 设为 0 可关闭 LLM，仅用量化规则生成报告
ENABLE_LLM=1

# ===== 宏观数据（可选）=====
# FRED API Key（https://fred.stlouisfed.org/docs/api/api_key.html，免费）
# 不填则用 10 年美债收益率(^TNX)作为利率走势的替代信号
FRED_API_KEY=
